__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
env/

# ─────────────────────────────────────────────
# Misc
# ─────────────────────────────────────────────
*.class
*.log
*.swp
.DS_Store
Thumbs.db
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ─────────────────────────────────────────────
# IDE
# ─────────────────────────────────────────────
*.iml
*.ipr
*.iws
.idea/
# .vscode/ — keep launch.json/tasks.json under version control if desired

# Eclipse / STM32CubeIDE (project metadata can be regenerated)
# .project
# .cproject
# .settings/

# ─────────────────────────────────────────────
# Flutter / Dart
# ─────────────────────────────────────────────
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
app.*.symbols
app.*.map.json
/android/app/debug
/android/app/profile
/android/app/release

# ─────────────────────────────────────────────
# STM32 / Embedded build artifacts
# ─────────────────────────────────────────────
Debug/
Release/
*.elf
*.bin
*.hex
*.map
*.list
*.o
*.d

# ─────────────────────────────────────────────
# Project runtime artifacts (do not commit user data)
# ─────────────────────────────────────────────
# SQLite runtime database (regenerated on startup)
sourceCode/RaspberryPi/posture_system.db
sourceCode/RaspberryPi/*.db-journal
sourceCode/RaspberryPi/*.db-wal
sourceCode/RaspberryPi/*.db-shm

# CSV sample logs collected at runtime
sourceCode/RaspberryPi/data/raw/
sourceCode/RaspberryPi/data/processed/
sourceCode/RaspberryPi/data/*.csv

# Local user profiles (keep templates only)
sourceCode/RaspberryPi/profiles/user_*.json
!sourceCode/RaspberryPi/profiles/user_test.json

# Trained ML models — track via Releases / external storage instead
# (currently keeping the bundled posture_rf.pkl for reproducibility;
#  uncomment the next line to exclude future binaries)
# sourceCode/RaspberryPi/saved_models/*.pkl
sourceCode/RaspberryPi/saved_models/*.joblib
sourceCode/RaspberryPi/saved_models/*.h5
